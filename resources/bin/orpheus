#!/bin/bash
# Orpheus CLI shim — runs the bundled CLI under Electron-as-Node.
#
# This script ships at Contents/Resources/bin/orpheus and is prepended to
# PATH in every workspace terminal (ORPHEUS_USER_PATH injection). It resolves
# the Electron binary and the CLI bundle relative to its own location so the
# paths are correct in both packaged and dev builds.
#
# Layout (packaged):
#   Contents/
#     MacOS/
#       Orpheus             ← Electron binary
#     Resources/
#       app.asar.unpacked/
#         node_modules/
#           better-sqlite3/ ← native module (unpacked from asar by electron-builder)
#       bin/
#         orpheus           ← this script
#         bun               ← bundled Bun runtime (darwin-arm64; see scripts/fetch-bun.sh)
#       cli/
#         cli.cjs            ← bundled CLI
#         tui-otui-smoke.mjs ← OpenTUI packaging smoke test (see below)
#         @opentui/
#           core-darwin-arm64/
#             libopentui.dylib
#
# Layout (dev, after bun run build:dev installs Orpheus Dev.app):
#   Contents/
#     MacOS/
#       Orpheus Dev         ← Electron binary
#     Resources/
#       app.asar.unpacked/
#         node_modules/
#           better-sqlite3/ ← native module (same layout as prod)
#       bin/
#         orpheus           ← this script
#         bun               ← bundled Bun runtime
#       cli/
#         cli.cjs            ← bundled CLI
#         tui-otui-smoke.mjs
#         @opentui/core-darwin-arm64/libopentui.dylib

set -eu

# BUN/OPENTUI BRANCH (`__otui-smoke`)
# ------------------------------------
# `@opentui/core`'s native rendering backend loads via `node:ffi`, which does
# not exist on Node 22 / Electron 39 — it only works under Bun. So anything
# OpenTUI-based cannot run through the Electron-as-Node path below and needs
# its own bundled Bun runtime, with OTUI_ASSET_ROOT pointed at the relocated
# native dylib so OpenTUI's asset resolver doesn't fall back to a bare
# `import("@opentui/core-darwin-arm64")` specifier — which Bun would try to
# auto-install from the npm registry, failing hard offline (see
# packages/orpheus-cli/src/tui/otui-smoke.ts's file header for the full
# story). `__otui-smoke` is an internal, undocumented entry point for
# packaging verification only — it is NOT `orpheus tui` and does not affect
# it. The real `orpheus tui` command (Ink, below) is untouched: the OpenTUI
# rebuild of that picker hasn't landed yet, so there is nothing to gain and
# a real behavioral regression to risk by repointing the live command at Bun
# before that rebuild exists.
if [ "${1:-}" = "__otui-smoke" ]; then
  shift
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  RESOURCES_DIR="$(dirname "$SCRIPT_DIR")"
  BUN_BIN="$SCRIPT_DIR/bun"
  OTUI_SMOKE_BUNDLE="$RESOURCES_DIR/cli/tui-otui-smoke.mjs"
  OTUI_ASSET_ROOT_DIR="$RESOURCES_DIR/cli"
  OTUI_DYLIB="$OTUI_ASSET_ROOT_DIR/@opentui/core-darwin-arm64/libopentui.dylib"

  if [ ! -x "$BUN_BIN" ]; then
    echo "orpheus: error: bundled Bun runtime not found at $BUN_BIN" >&2
    echo "  This is a packaging problem, not a user error — the app bundle is missing" >&2
    echo "  its vendored Bun binary. Run 'bun run fetch:bun' and rebuild the app." >&2
    exit 1
  fi
  if [ ! -f "$OTUI_SMOKE_BUNDLE" ]; then
    echo "orpheus: error: OpenTUI smoke bundle not found at $OTUI_SMOKE_BUNDLE" >&2
    echo "  This is a packaging problem — run 'bun run build:cli:tui:otui-smoke' and rebuild the app." >&2
    exit 1
  fi
  if [ ! -f "$OTUI_DYLIB" ]; then
    echo "orpheus: error: OpenTUI native library not found at $OTUI_DYLIB" >&2
    echo "  This is a packaging problem — the libopentui.dylib asset was not staged" >&2
    echo "  alongside the CLI bundle. Run 'bun run build:cli:tui:otui-smoke' (which" >&2
    echo "  runs scripts/package-tui-assets.mjs) and rebuild the app." >&2
    exit 1
  fi

  export OTUI_ASSET_ROOT="$OTUI_ASSET_ROOT_DIR"
  exec "$BUN_BIN" run "$OTUI_SMOKE_BUNDLE" "$@"
fi

# NODE_PATH for better-sqlite3
# ----------------------------
# The CLI bundle externalizes better-sqlite3 so the native .node addon can be
# loaded at runtime. However, cli.cjs lives at Resources/cli/cli.cjs — it has no
# node_modules ancestor containing better-sqlite3. We must point Node at the
# unpacked location via NODE_PATH before exec'ing the bundle.
#
# electron-builder's asarUnpack extracts native modules (matching '**/*.node')
# to Resources/app.asar.unpacked/. The canonical location is therefore:
#   Resources/app.asar.unpacked/node_modules/
#
# We try that path first, then fall back to a sibling Resources/node_modules/
# in case a future layout change moves things. NODE_PATH is additive — we
# prepend so our path is searched first, with any existing NODE_PATH appended.

# Resolve the directory containing this script, following symlinks.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# The Resources dir is one level up from bin/.
RESOURCES_DIR="$(dirname "$SCRIPT_DIR")"

# The MacOS dir is a sibling of Resources/.
MACOS_DIR="$(dirname "$RESOURCES_DIR")/MacOS"

# The bundled CLI lives at Resources/cli/cli.cjs.
CLI_BUNDLE="$RESOURCES_DIR/cli/cli.cjs"

# Locate the native module directory and set NODE_PATH.
# Primary: Resources/app.asar.unpacked/node_modules (standard electron-builder asarUnpack layout)
# Fallback: Resources/node_modules (non-asar dev layout, future-proofing)
UNPACKED_NM="$RESOURCES_DIR/app.asar.unpacked/node_modules"
SIBLING_NM="$RESOURCES_DIR/node_modules"

if [ -d "$UNPACKED_NM" ]; then
  ORPHEUS_NODE_PATH="$UNPACKED_NM"
elif [ -d "$SIBLING_NM" ]; then
  ORPHEUS_NODE_PATH="$SIBLING_NM"
else
  ORPHEUS_NODE_PATH=""
fi

# Prepend to existing NODE_PATH (may be unset — guard with :- default).
if [ -n "$ORPHEUS_NODE_PATH" ]; then
  export NODE_PATH="$ORPHEUS_NODE_PATH${NODE_PATH:+:${NODE_PATH}}"
fi

# Find the Electron binary for worktree, nightly, development, or production builds.
if [ -x "$MACOS_DIR/Orpheus WT" ]; then
  ELECTRON_BIN="$MACOS_DIR/Orpheus WT"
elif [ -x "$MACOS_DIR/Orpheus Dev" ]; then
  ELECTRON_BIN="$MACOS_DIR/Orpheus Dev"
elif [ -x "$MACOS_DIR/Orpheus Nightly" ]; then
  ELECTRON_BIN="$MACOS_DIR/Orpheus Nightly"
elif [ -x "$MACOS_DIR/Orpheus" ]; then
  ELECTRON_BIN="$MACOS_DIR/Orpheus"
else
  echo "orpheus: error: cannot find Electron binary in $MACOS_DIR" >&2
  echo "  Expected 'Orpheus WT', 'Orpheus Dev', 'Orpheus Nightly', or 'Orpheus' — is the app bundle intact?" >&2
  exit 1
fi

if [ ! -f "$CLI_BUNDLE" ]; then
  echo "orpheus: error: CLI bundle not found at $CLI_BUNDLE" >&2
  echo "  Run 'bun run build:cli' to build the bundle." >&2
  exit 1
fi

# Run the CLI bundle under Electron's bundled Node runtime. The env var must be
# exported before exec — `exec VAR=val cmd` would try to exec "VAR=val" itself.
export ELECTRON_RUN_AS_NODE=1
exec "$ELECTRON_BIN" "$CLI_BUNDLE" "$@"
