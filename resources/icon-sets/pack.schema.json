{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Orpheus icon pack manifest",
  "description": "Manifest contract for a selectable Orpheus icon pack.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "variants",
    "modeFallbacks"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production", "development", "nightly"],
      "properties": {
        "production": {
          "$ref": "#/definitions/variant"
        },
        "development": {
          "$ref": "#/definitions/variant"
        },
        "nightly": {
          "$ref": "#/definitions/variant"
        }
      }
    },
    "modeFallbacks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree"],
      "properties": {
        "worktree": {
          "const": "development"
        }
      }
    }
  },
  "definitions": {
    "svgPath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._@-]*/)*[A-Za-z0-9][A-Za-z0-9._@-]*\\.svg$"
    },
    "pngPath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._@-]*/)*[A-Za-z0-9][A-Za-z0-9._@-]*\\.png$"
    },
    "icnsPath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._@-]*/)*[A-Za-z0-9][A-Za-z0-9._@-]*\\.icns$"
    },
    "iconsetPath": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._@-]*/)*[A-Za-z0-9][A-Za-z0-9._@-]*\\.iconset$"
    },
    "appAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSvg", "runtimePng", "iconsetDirectory", "icns"],
      "properties": {
        "sourceSvg": {
          "$ref": "#/definitions/svgPath"
        },
        "runtimePng": {
          "$ref": "#/definitions/pngPath"
        },
        "iconsetDirectory": {
          "$ref": "#/definitions/iconsetPath"
        },
        "icns": {
          "$ref": "#/definitions/icnsPath"
        }
      }
    },
    "menuBarAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSvg",
        "png1x",
        "png2x",
        "templateSourceSvg",
        "templatePng1x",
        "templatePng2x"
      ],
      "properties": {
        "sourceSvg": {
          "$ref": "#/definitions/svgPath"
        },
        "png1x": {
          "$ref": "#/definitions/pngPath"
        },
        "png2x": {
          "$ref": "#/definitions/pngPath"
        },
        "templateSourceSvg": {
          "$ref": "#/definitions/svgPath"
        },
        "templatePng1x": {
          "$ref": "#/definitions/pngPath"
        },
        "templatePng2x": {
          "$ref": "#/definitions/pngPath"
        }
      }
    },
    "previewAssets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["png1x", "png2x"],
      "properties": {
        "png1x": {
          "$ref": "#/definitions/pngPath"
        },
        "png2x": {
          "$ref": "#/definitions/pngPath"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["app", "menuBar", "previews"],
      "properties": {
        "app": {
          "$ref": "#/definitions/appAssets"
        },
        "menuBar": {
          "$ref": "#/definitions/menuBarAssets"
        },
        "previews": {
          "$ref": "#/definitions/previewAssets"
        }
      }
    }
  }
}
