{
  "name": "orpheus",
  "version": "0.5.9",
  "private": true,
  "description": "A Mac IDE built around Claude Code",
  "author": "Amit Ray <hey@amitray.dev>",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "bun@1.3.10",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitray007/orpheus.git"
  },
  "homepage": "https://github.com/amitray007/orpheus#readme",
  "bugs": {
    "url": "https://github.com/amitray007/orpheus/issues"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "react-doctor",
    "doctor:ci": "react-doctor --scope changed --no-score --no-color",
    "lint": "eslint --cache .",
    "check:arch": "depcruise src packages/orpheus-cli --config .dependency-cruiser.cjs",
    "check:dup": "jscpd",
    "check:dead": "knip",
    "check": "bun run typecheck && bun run lint && bun run check:dup && bun run check:arch",
    "test:db": "node --experimental-strip-types scripts/verify-migration-engine.ts",
    "test:flags": "node --experimental-strip-types scripts/verify-cli-flags.ts",
    "tui:dev": "./scripts/tui-dev.sh",
    "test:tui": "bun run scripts/verify-tui-layout.ts",
    "test:tui-blocks": "bun run scripts/verify-tui-blocks.ts",
    "test:tui-wizard": "bun run scripts/verify-tui-wizard.ts",
    "test:workbench": "bun run scripts/verify-workbench-reducer.ts",
    "test:models": "bun run scripts/verify-model-registry.ts",
    "test:routing": "bun run scripts/verify-routing.ts",
    "test:proxy": "bun run scripts/verify-routing-proxy.ts",
    "test:providers": "bun run scripts/verify-providers.ts",
    "test:provider-usage": "bun run scripts/verify-provider-usage-parsers.ts && bun run scripts/verify-provider-usage-cursor-grok.ts",
    "test:aliases": "bun run scripts/verify-aliases.ts",
    "test:picker": "bun run scripts/verify-model-picker.ts",
    "test:effort": "bun run scripts/verify-effort-levels.ts",
    "test:model-refresh": "bun run scripts/verify-model-refresh.ts",
    "test:refresh-models-button": "bun run scripts/verify-refresh-models-button.ts",
    "test:overlay-purity": "bun run scripts/verify-overlay-window-api-purity.ts",
    "test:oauth": "bun run scripts/verify-oauth.ts",
    "test:overlay": "bun run scripts/verify-loading-overlay.ts",
    "test:creation": "bun run scripts/verify-creation-provider-menu.ts",
    "test:picker-icons": "bun run scripts/verify-model-picker-icons.ts",
    "test:creation-menu": "bun run scripts/verify-new-workspace-menu.ts",
    "test:overlay-dismissal": "bun run scripts/verify-overlay-dismissal.ts",
    "test:keep-awake": "bun run scripts/verify-native-idle-activity.ts",
    "test:control-plane": "bun run scripts/verify-control-plane.ts",
    "test:terminal-observation": "bun run scripts/verify-terminal-observability.ts",
    "test:workspace-orchestration:foundation": "bun run scripts/verify-workspace-orchestration-foundation.ts",
    "test:workspace-orchestration:main": "bun run scripts/verify-workspace-orchestration-main.ts",
    "test:workspace-orchestration:cli": "bun run build:cli && bun run scripts/verify-cli-phase3-compat.ts",
    "test:workspace-orchestration:renderer-actions": "bun run scripts/verify-workspace-renderer-actions.ts",
    "test:workspace-orchestration": "bun run test:workspace-orchestration:foundation && bun run test:workspace-orchestration:main && bun run test:workspace-orchestration:cli && bun run test:workspace-orchestration:renderer-actions",
    "test:workbench-control": "bun run scripts/verify-workbench-pane-control.ts",
    "test:settings-resources": "bun run scripts/verify-control-plane-phase6.ts",
    "test:automations": "bun run scripts/verify-durable-automations.ts",
    "test:automation-operations": "bun run scripts/verify-production-automation-operations.ts",
    "test:agentic-integration:harness": "bun run scripts/verify-agentic-integration.ts",
    "test:log-redaction": "bun run scripts/verify-log-redaction.ts",
    "test:agentic": "bun run scripts/verify-agentic-regression.ts",
    "test:agentic-integration": "bun run test:agentic",
    "test:mcp": "bun run build:mcp && bun run scripts/verify-mcp-bridge.ts",
    "test:tmux": "bun run scripts/verify-tmux-host.ts",
    "test:tmux:integration": "bun run scripts/verify-tmux-integration.ts",
    "typecheck:mcp": "tsc --noEmit -p packages/orpheus-mcp/tsconfig.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web && bun run typecheck:mcp",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "bun run typecheck && bun run build:agents && electron-vite build",
    "postinstall": "electron-builder install-app-deps && bash scripts/fetch-libghostty.sh",
    "install:mac": "node scripts/install-mac.mjs --dev",
    "install:mac-wt": "node scripts/install-mac.mjs --wt",
    "install:mac-nightly": "node scripts/install-mac.mjs --nightly",
    "install:mac-prod": "node scripts/install-mac.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:unpack": "bun run build:dev",
    "build:cli": "bunx esbuild packages/orpheus-cli/src/cli.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=packages/orpheus-cli/dist/cli.cjs",
    "build:cli:tui": "bunx esbuild packages/orpheus-cli/src/tui/entry.ts --bundle --splitting --platform=node --format=esm --external:electron --external:react-devtools-core --outdir=packages/orpheus-cli/dist --entry-names=tui --out-extension:.js=.mjs --banner:js=\"import{createRequire as __orpheusCreateRequire}from 'node:module';const require=__orpheusCreateRequire(import.meta.url);\"",
    "build:mcp": "bunx esbuild packages/orpheus-mcp/src/server.ts --bundle --platform=node --format=cjs --outfile=packages/orpheus-mcp/dist/mcp.cjs",
    "build:agents": "bun run build:cli && bun run build:cli:tui && bun run build:mcp",
    "build:dev": "bun run build:native && ORPHEUS_MODE=development bun run build && GOMAXPROCS=1 bunx electron-builder --config electron-builder-dev.yml --dir && bun run install:mac",
    "build:wt": "bun run build:native && ORPHEUS_MODE=worktree bun run build && GOMAXPROCS=1 bunx electron-builder --config electron-builder-wt.yml --dir && bun run install:mac-wt",
    "build:nightly": "bun run build:native && ORPHEUS_MODE=nightly bun run build && GOMAXPROCS=1 bunx electron-builder --config electron-builder-nightly.yml && bun run install:mac-nightly",
    "build:mac": "bun run build:native && bun run build && GOMAXPROCS=1 electron-builder --mac && bun run install:mac-prod",
    "fetch:libghostty": "bash scripts/fetch-libghostty.sh",
    "bump:libghostty": "bun scripts/bump-libghostty.mjs",
    "diag": "bun scripts/diag.ts",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,jsx,json,yml,yaml,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.11",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@pierre/diffs": "1.2.12",
    "@pierre/theme": "1.1.0",
    "@pierre/trees": "1.0.0-beta.5",
    "@tanstack/react-table": "^8.21.3",
    "@web-kits/audio": "^0.1.0",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.12",
    "geist": "^1.7.0",
    "ink": "^7.1.1",
    "markdown-it": "^14.3.0",
    "minidenticons": "^4.2.1",
    "motion": "^12.42.2",
    "radix-ui": "^1.6.2",
    "recharts": "3.9.2",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^18.0.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.1.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.11",
    "knip": "^6.24.0",
    "lint-staged": "^17.0.8",
    "next": "16.2.11",
    "prettier": "^3.8.3",
    "react": "^19.2.1",
    "react-doctor": "^0.8.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "dompurify": "3.4.12",
    "electron-builder-squirrel-windows": "26.15.3",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.4",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "postcss": "8.5.18",
    "sharp": "0.35.0",
    "tar": "7.5.21",
    "tmp": "0.2.7",
    "undici": "6.27.0"
  }
}
